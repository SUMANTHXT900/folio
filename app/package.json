{
  "name": "folio-pdf",
  "private": true,
  "version": "1.8.0",
  "description": "Folio - private, fully local PDF tools. PDF manipulation runs on the Folio Rust/WASM engine in a Web Worker; PDF.js handles rendering and previews.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "cd ../wasm && wasm-pack build --target web --out-dir pkg",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:scan": "cd ../scan && wasm-pack build --target web --out-dir pkg"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^13.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.3",
    "wrangler": "^4.123.0"
  }
}
